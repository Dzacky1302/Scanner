<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Live Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Bar with Flash and Back -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="#88000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Pindai Banyak Halaman / Buku"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="#FFFFFF"
                android:contentDescription="@string/app_name" />

        </LinearLayout>

        <!-- Mode Selection Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabBackground="@android:color/transparent"
            app:tabIndicatorColor="#0D6EFD"
            app:tabSelectedTextColor="#0D6EFD"
            app:tabTextColor="#CCCCCC"
            app:tabMode="fixed">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Buku/Tugas" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪪 KTP / ID" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛂 Paspor" />

        </com.google.android.material.tabs.TabLayout>

    </LinearLayout>

    <!-- Center Instructional Scanner Frame Overlay -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomPanel"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="#AA000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Foto halaman 1, 2, 3... berurutan lalu tekan Review"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgGuideFrame"
            android:layout_width="280dp"
            android:layout_height="360dp"
            android:layout_centerInParent="true"
            android:src="@drawable/shape_aesthetic_frame"
            android:contentDescription="@string/app_name" />

        <View
            android:layout_width="260dp"
            android:layout_height="2dp"
            android:layout_centerInParent="true"
            android:background="#00E5FF" />

    </RelativeLayout>

    <!-- Bottom Panel with Horizontal Page Thumbnails & Action Buttons -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#99000000"
        android:paddingBottom="16dp">

        <!-- Captured Pages Horizontal Thumbnails RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvThumbnails"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Control Action Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnCapture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:contentDescription="@string/app_name"
                app:fabCustomSize="64dp"
                app:maxImageSize="32dp"
                app:srcCompat="@android:drawable/ic_menu_camera"
                app:backgroundTint="#0D6EFD"
                app:tint="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Review (0)"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_save" />

        </RelativeLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>
